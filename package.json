{
  "name": "mock-interviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "server": "bun --watch server/index.ts",
    "web": "bun --bun vite",
    "test": "bun test",
    "eval": "bun run evals/grader-consistency.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p .",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@ricky0123/vad-web": "^0.0.31",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.31.1",
    "openai": "^7.65.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "description": "Voice mock interviews (system design and recruiter screens) with an AI interviewer that listens, watches your whiteboard, pushes back, and grades you against a rubric. Bring your own API key.",
  "license": "MIT"
}
