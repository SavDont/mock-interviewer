# Copy to .env and fill in ONE provider's key. You can also paste a key in the app instead
# (click "API key" on the first screen); keys entered there are kept in memory only.

# Anthropic (Claude). Get a key at https://console.anthropic.com/settings/keys
# (Or skip the key and run `ant auth login`; the server uses that login.)
ANTHROPIC_API_KEY=

# OpenAI. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider to use when both have keys: anthropic or openai. Defaults to whichever has a key.
# LLM_PROVIDER=anthropic

# Models (defaults shown)
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.5

# Thinking depth: low, medium or high
# INTERVIEWER_EFFORT=low        # the frequent "should I speak?" checks (low keeps replies quick)
# FEEDBACK_EFFORT=high          # the debrief after a call

# INTERVIEWER_FAST=0            # turn off Anthropic fast mode (on by default: quicker replies, 2x price)
# DEBUG=1                       # log each check's timing, token counts and reply to the terminal
# API_PORT=8787
# WHISPER_PORT=8178
# WHISPER_MODEL=models/ggml-base.en.bin
